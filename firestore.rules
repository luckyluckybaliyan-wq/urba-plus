rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- USERS COLLECTION ---
    match /users/{userId} {
      allow read, write: if true;
    }

    // --- ISSUES COLLECTION ---
    match /issues/{issueId} {
      allow read, write: if true;
    }

    // --- AUDIT LOGS COLLECTION ---
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // --- DEFAULT CATCH-ALL ---
    match /{document=**} {
      allow read, write: if true;
    }
  }
}



