# =============================================================================
# URBA+ / CIVIC SENTINEL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env (or .env.local) and fill in your real values.
# Never commit your actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_URL="http://localhost:3000"
PORT=3000

# -----------------------------------------------------------------------------
# GEMINI AI  —  https://aistudio.google.com/apikey
# Required for: image analysis, duplicate detection, resolution verification.
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# -----------------------------------------------------------------------------
# FIREBASE — CLIENT SDK  (NEXT_PUBLIC_ prefix exposes these to the browser)
# Firebase Console → Project Settings → Your apps → Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxxxxxxxxxx"
# Use "(default)" if you haven't created a named Firestore database
NEXT_PUBLIC_FIREBASE_DATABASE_ID="(default)"

# -----------------------------------------------------------------------------
# FIREBASE — ADMIN SDK  (server-side only)
# Option A — path to service account JSON file (Cloud Run / GKE):
GOOGLE_APPLICATION_CREDENTIALS=""
# Option B — inline service account JSON as a single-line string (Vercel / local):
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=""

# -----------------------------------------------------------------------------
# SMTP — EMAIL NOTIFICATIONS  (nodemailer)
# Omit / leave blank to use simulated inbox-only delivery mode.
# Gmail: enable 2FA then create an App Password at myaccount.google.com/apppasswords
# Port 587 = STARTTLS  |  Port 465 = SMTPS (implicit TLS)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@your-domain.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="\"Civic Sentinel Notifications\" <notifications@your-domain.com>"
